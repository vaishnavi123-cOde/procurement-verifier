# ===========================================================================
# Procurement Verifier — environment configuration (safe to commit).
# Copy to `.env` and fill in real values. Never commit real secrets.
# ===========================================================================

# ---- Application -----------------------------------------------------------
ENVIRONMENT=development            # development | production
DEBUG=false                        # when true, internal error details are echoed to clients
LOG_LEVEL=INFO

# ---- Database --------------------------------------------------------------
# Development: SQLite (default, zero-dependency).
# DATABASE_URL=sqlite:///data/procurement.db
# Production: PostgreSQL (used by docker-compose).
# DATABASE_URL=postgresql+psycopg://pv:pv@postgres:5432/procurement
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT=30

# ---- Qdrant vector store ---------------------------------------------------
# Development: in-memory Qdrant (no server needed).
VECTOR_STORE_MODE=memory            # memory | server
# Production: persistent Qdrant. QDRANT_URL wins over vector_host/vector_port.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=procurement_documents
VECTOR_HOST=localhost
VECTOR_PORT=6333
VECTOR_COLLECTION=procurement_documents
EMBEDDING_DIM=384
EMBEDDING_PROVIDER=hash            # hash | ollama | transformers

# ---- LLM (optional; no container is required) ------------------------------
# none = deterministic fallback (benchmark-safe). No LLM is required for
# benchark/evaluation runs.
LLM_PROVIDER=none                   # none | ollama | api
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_MODEL=gpt-4o-mini
LLM_API_KEY=                        # secret — never commit
LLM_TIMEOUT_SECONDS=60

# ---- Uploads ---------------------------------------------------------------
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=['.pdf']         # JSON-style list

# ---- Auth / security -------------------------------------------------------
# Local development stays open by default. Set true (+ strong secrets below)
# for shared/production deployments.
AUTH_ENABLED=false
AUTH_BOOTSTRAP_TOKEN=dev-bootstrap-token   # required to mint API tokens
AUTH_JWT_SECRET=dev-only-change-me         # secret — never commit
ACCESS_TOKEN_TTL_MINUTES=120

# ---- CORS ------------------------------------------------------------------
# JSON-style array of allowed browser origins. "*" allows everything
# (credentials are then disabled automatically).
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# ---- Rate limiting (lightweight in-memory; off by default) -----------------
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=120

# ---- Observability ---------------------------------------------------------
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317

# ---- Dataset root (benchmark source data is intentional and committed) -----
DATASET_ROOT=data